{
  "$schema": "https://yamcs.org/schema/stack.schema.json",
  "steps": [
    {
      "type": "command",
      "name": "/ADCS/ADCS_ENABLE_CC",
      "extraOptions": [],
      "arguments": []
    },
    {
      "type": "verify",
      "condition": [
        {
          "parameter": "/ADCS/DEVICE_ENABLED",
          "operator": "eq",
          "value": "1"
        }
      ]
    },
    {
      "type": "command",
      "name": "/ADCS/ADCS_SET_MODE_CC",
      "extraOptions": [],
      "arguments": [
        {
          "name": "MODE",
          "value": "SUNSAFE"
        }
      ]
    },
    {
      "type": "verify",
      "condition": [
        {
          "parameter": "/ADCS/SUN_X",
          "operator": "gt",
          "value": "0.98"
        },
        {
          "parameter": "/ADCS/SUN_Y",
          "operator": "lt",
          "value": "0.02"
        },
        {
          "parameter": "/ADCS/SUN_Y",
          "operator": "gt",
          "value": "-0.02"
        },
        {
          "parameter": "/ADCS/SUN_Z",
          "operator": "lt",
          "value": "0.02"
        },
        {
          "parameter": "/ADCS/SUN_Z",
          "operator": "gt",
          "value": "-0.02"
        }
      ],
      "timeout": 120000
    },
    {
      "type": "verify",
      "condition": [
        {
          "parameter": "/ADCS/ANGRATE_X",
          "operator": "gt",
          "value": "0.003"
        },
        {
          "parameter": "/ADCS/ANGRATE_X",
          "operator": "lt",
          "value": "0.007"
        }
      ],
      "timeout": 60000
    },
    {
      "type": "verify",
      "condition": [
        {
          "parameter": "/ADCS/SUN_X",
          "operator": "gt",
          "value": "0.98"
        },
        {
          "parameter": "/ADCS/SUN_Y",
          "operator": "lt",
          "value": "0.02"
        },
        {
          "parameter": "/ADCS/SUN_Y",
          "operator": "gt",
          "value": "-0.02"
        },
        {
          "parameter": "/ADCS/SUN_Z",
          "operator": "lt",
          "value": "0.02"
        },
        {
          "parameter": "/ADCS/SUN_Z",
          "operator": "gt",
          "value": "-0.02"
        }
      ],
      "timeout": 30000
    }
  ],
  "advancement": {
    "acknowledgment": "Acknowledge_Sent",
    "wait": 1000
  }
}
