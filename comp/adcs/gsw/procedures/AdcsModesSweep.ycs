{
  "$schema": "https://yamcs.org/schema/stack.schema.json",
  "steps": [
    {
      "type": "command",
      "name": "/ADCS/ADCS_ENABLE_CC",
      "extraOptions": [],
      "arguments": []
    },
    {
      "type": "verify",
      "condition": [
        {
          "parameter": "/ADCS/DEVICE_ENABLED",
          "operator": "eq",
          "value": "1"
        }
      ]
    },
    {
      "__comment": "Sun point (mode 2, SUNSAFE).",
      "type": "command",
      "name": "/ADCS/ADCS_SET_MODE_CC",
      "extraOptions": [],
      "arguments": [
        {
          "name": "MODE",
          "value": "SUNSAFE"
        }
      ]
    },
    {
      "type": "verify",
      "condition": [
        {
          "parameter": "/ADCS/SUN_X",
          "operator": "gt",
          "value": "0.98"
        },
        {
          "parameter": "/ADCS/SUN_Y",
          "operator": "lt",
          "value": "0.02"
        },
        {
          "parameter": "/ADCS/SUN_Y",
          "operator": "gt",
          "value": "-0.02"
        },
        {
          "parameter": "/ADCS/SUN_Z",
          "operator": "lt",
          "value": "0.02"
        },
        {
          "parameter": "/ADCS/SUN_Z",
          "operator": "gt",
          "value": "-0.02"
        }
      ],
      "timeout": 120000
    },
    {
      "__comment": "Nadir point (mode 3): no dedicated ground-visible check existed for this mode before -- only unit tests. Shares adcs_point_vector_controller() with target-track, so the same qn scalar-order fix applies here too.",
      "type": "command",
      "name": "/ADCS/ADCS_SET_MODE_CC",
      "extraOptions": [],
      "arguments": [
        {
          "name": "MODE",
          "value": "NADIR"
        }
      ]
    },
    {
      "type": "verify",
      "condition": [
        {
          "parameter": "/ADCS/ANGRATE_X",
          "operator": "lt",
          "value": "0.02"
        },
        {
          "parameter": "/ADCS/ANGRATE_X",
          "operator": "gt",
          "value": "-0.02"
        },
        {
          "parameter": "/ADCS/ANGRATE_Y",
          "operator": "lt",
          "value": "0.02"
        },
        {
          "parameter": "/ADCS/ANGRATE_Y",
          "operator": "gt",
          "value": "-0.02"
        },
        {
          "parameter": "/ADCS/ANGRATE_Z",
          "operator": "lt",
          "value": "0.02"
        },
        {
          "parameter": "/ADCS/ANGRATE_Z",
          "operator": "gt",
          "value": "-0.02"
        }
      ],
      "timeout": 30000
    },
    {
      "__comment": "Target an arbitrary inertial direction via the new SET_TARGET_VECTOR_CC (issue follow-up), standing in for 'the Moon' pending real ephemeris wiring (42 tracks World[LUNA] internally, but it is not yet piped through simulith's IPC protocol to ADCS -- see conversation notes). The device normalizes this on receipt; sending an un-normalized (1,1,1) here also exercises that.",
      "type": "command",
      "name": "/ADCS/ADCS_SET_TARGET_VECTOR_CC",
      "extraOptions": [],
      "arguments": [
        {
          "name": "TARGET_X",
          "value": "1.0"
        },
        {
          "name": "TARGET_Y",
          "value": "1.0"
        },
        {
          "name": "TARGET_Z",
          "value": "1.0"
        }
      ]
    },
    {
      "type": "command",
      "name": "/ADCS/ADCS_SET_MODE_CC",
      "extraOptions": [],
      "arguments": [
        {
          "name": "MODE",
          "value": "TARGET"
        }
      ]
    },
    {
      "type": "verify",
      "condition": [
        {
          "parameter": "/ADCS/ANGRATE_X",
          "operator": "lt",
          "value": "0.02"
        },
        {
          "parameter": "/ADCS/ANGRATE_X",
          "operator": "gt",
          "value": "-0.02"
        },
        {
          "parameter": "/ADCS/ANGRATE_Y",
          "operator": "lt",
          "value": "0.02"
        },
        {
          "parameter": "/ADCS/ANGRATE_Y",
          "operator": "gt",
          "value": "-0.02"
        },
        {
          "parameter": "/ADCS/ANGRATE_Z",
          "operator": "lt",
          "value": "0.02"
        },
        {
          "parameter": "/ADCS/ANGRATE_Z",
          "operator": "gt",
          "value": "-0.02"
        }
      ],
      "timeout": 30000
    }
  ],
  "advancement": {
    "acknowledgment": "Acknowledge_Sent",
    "wait": 1000
  }
}
