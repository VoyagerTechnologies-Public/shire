{
  "$schema": "https://yamcs.org/schema/stack.schema.json",
  "steps": [
    {
      "type": "command",
      "name": "/ADCS/ADCS_ENABLE_CC",
      "extraOptions": [],
      "arguments": []
    },
    {
      "type": "verify",
      "condition": [
        {
          "parameter": "/ADCS/DEVICE_ENABLED",
          "operator": "eq",
          "value": "1"
        }
      ]
    },
    {
      "type": "command",
      "name": "/ADCS/ADCS_SET_MODE_CC",
      "extraOptions": [],
      "arguments": [
        {
          "name": "MODE",
          "value": "SUNSAFE"
        }
      ]
    },
    {
      "type": "verify",
      "condition": [
        {
          "parameter": "/ADCS/SUN_X",
          "operator": "gt",
          "value": "0.98"
        },
        {
          "parameter": "/ADCS/SUN_Y",
          "operator": "lt",
          "value": "0.02"
        },
        {
          "parameter": "/ADCS/SUN_Y",
          "operator": "gt",
          "value": "-0.02"
        },
        {
          "parameter": "/ADCS/SUN_Z",
          "operator": "lt",
          "value": "0.02"
        },
        {
          "parameter": "/ADCS/SUN_Z",
          "operator": "gt",
          "value": "-0.02"
        }
      ],
      "timeout": 120000
    },
    {
      "__comment": "This 'approx' condition is a headless-commander-only extension (not part of the official YAMCS stack schema) -- see yamcs_commander.py's APPROX_OPERATOR comment. It formalizes atlas/docs/scenarios/adcs-truth-comparison.md's manual, non-asserting comparison into a real pass/fail check: /ADCS telemetry (sim -> UART -> cFE -> SB -> CCSDS -> YAMCS) must numerically agree with /SIM_42_TRUTH (director -> UDP -> YAMCS) within tolerance, at the same live moment.",
      "type": "verify",
      "condition": [
        {
          "parameter": "/ADCS/SUN_X",
          "operator": "approx",
          "reference_parameter": "/SIM_42_TRUTH/SVB_1",
          "tolerance": 0.02
        },
        {
          "parameter": "/ADCS/SUN_Y",
          "operator": "approx",
          "reference_parameter": "/SIM_42_TRUTH/SVB_2",
          "tolerance": 0.02
        },
        {
          "parameter": "/ADCS/SUN_Z",
          "operator": "approx",
          "reference_parameter": "/SIM_42_TRUTH/SVB_3",
          "tolerance": 0.02
        }
      ],
      "timeout": 30000
    }
  ],
  "advancement": {
    "acknowledgment": "Acknowledge_Sent",
    "wait": 1000
  }
}
