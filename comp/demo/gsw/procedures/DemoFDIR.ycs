{
  "$schema": "https://yamcs.org/schema/stack.schema.json",
  "steps": [
    {
      "type": "text",
      "text": "Fault Detection, Isolation, and Recovery (FDIR).\n* Enable the device\n* Confirm valid telemetry, compare to truth\n* Use backdoor to randomize telemetry\n* Confirm error\n* Confirm automated spacecraft RTS11 response\n* Restore functionality\n* Confirm valid telemetry"
    },
    {
      "type": "text",
      "text": "Arm LC action point 11. LC makes an action point passive after it trips, so a repeat run needs it armed again."
    },
    {
      "type": "command",
      "name": "/LC/LC_COMMANDS/LC_SET_AP_STATE",
      "extraOptions": [],
      "arguments": [
        {
          "name": "APNUMBER",
          "value": "11"
        },
        {
          "name": "NEWAPSTATE",
          "value": "LC_APSTATE_ACTIVE"
        }
      ]
    },
    {
      "type": "command",
      "name": "/LC/LC_COMMANDS/LC_RESET_AP_STATS",
      "extraOptions": [],
      "arguments": [
        {
          "name": "APNUMBER",
          "value": "11"
        },
        {
          "name": "PADDING",
          "value": "0"
        }
      ]
    },
    {
      "type": "command",
      "name": "/DEMO/DEMO_RST_COUNTERS_CC",
      "extraOptions": [],
      "arguments": []
    },
    {
      "type": "command",
      "name": "/DEMO/DEMO_REQ_HK",
      "extraOptions": [],
      "arguments": []
    },
    {
      "type": "command",
      "name": "/DEMO/DEMO_NOOP_CC",
      "extraOptions": [],
      "arguments": []
    },
    {
      "type": "command",
      "name": "/DEMO/DEMO_REQ_HK",
      "extraOptions": [],
      "arguments": []
    },
    {
      "type": "verify",
      "condition": [
        {
          "parameter": "/DEMO/CMD_COUNT",
          "operator": "eq",
          "value": "1"
        }
      ]
    },
    {
      "type": "command",
      "name": "/DEMO/DEMO_ENABLE_CC",
      "extraOptions": [],
      "arguments": []
    },
    {
      "type": "command",
      "name": "/DEMO/DEMO_REQ_HK",
      "extraOptions": [],
      "arguments": []
    },
    {
      "type": "verify",
      "condition": [
        {
          "parameter": "/DEMO/DEVICE_ENABLED",
          "operator": "eq",
          "value": "ENABLED"
        }
      ]
    },
    {
      "type": "verify",
      "condition": [
        {
          "parameter": "/DEMO/CHAN1",
          "operator": "gte",
          "value": "256"
        },
        {
          "parameter": "/DEMO/CHAN2",
          "operator": "gte",
          "value": "256"
        },
        {
          "parameter": "/DEMO/CHAN3",
          "operator": "gte",
          "value": "256"
        }
      ],
      "comment": "Confirm device operating nominally."
    },
    {
      "type": "command",
      "name": "/DEMO/BACKDOOR_DEMO_RAND_DATA",
      "comment": "Inject device data fault via simulation backdoor.",
      "stream": "tc_backdoor",
      "extraOptions": [],
      "arguments": [
        {
          "name": "ENABLE",
          "value": "ENABLE"
        }
      ]
    },
    {
      "type": "verify",
      "condition": [
        {
          "parameter": "/DEMO/CHAN1",
          "operator": "lt",
          "value": "256"
        },
        {
          "parameter": "/DEMO/CHAN2",
          "operator": "lt",
          "value": "256"
        },
        {
          "parameter": "/DEMO/CHAN3",
          "operator": "lt",
          "value": "256"
        }
      ],
      "comment": "Confirm device data invalid."
    },
    {
      "type": "verify",
      "condition": [
        {
          "parameter": "/SC/SC_HKTLM/RTSEXECUTINGSTATUS_1",
          "operator": "gte",
          "value": "1024"
        }
      ],
      "comment": "Confirm spacecraft detects and acts on demo component data error."
    },
    {
      "type": "command",
      "name": "/DEMO/BACKDOOR_DEMO_RAND_DATA",
      "comment": "Disable device data fault via simulation backdoor.",
      "stream": "tc_backdoor",
      "extraOptions": [],
      "arguments": [
        {
          "name": "ENABLE",
          "value": "DISABLE"
        }
      ]
    },
    {
      "type": "verify",
      "condition": [
        {
          "parameter": "/DEMO/DEVICE_ENABLED",
          "operator": "eq",
          "value": "DISABLED"
        }
      ]
    },
    {
      "type": "verify",
      "condition": [
        {
          "parameter": "/DEMO/DEVICE_ENABLED",
          "operator": "eq",
          "value": "ENABLED"
        }
      ]
    },
    {
      "type": "verify",
      "condition": [
        {
          "parameter": "/DEMO/CHAN1",
          "operator": "gte",
          "value": "256"
        },
        {
          "parameter": "/DEMO/CHAN2",
          "operator": "gte",
          "value": "256"
        },
        {
          "parameter": "/DEMO/CHAN3",
          "operator": "gte",
          "value": "256"
        }
      ],
      "comment": "Confirm device operating nominally."
    },
    {
      "type": "text",
      "text": "Restore: the action point went passive when it tripped, so arm it again and leave the spacecraft in its boot state."
    },
    {
      "type": "command",
      "name": "/LC/LC_COMMANDS/LC_SET_AP_STATE",
      "extraOptions": [],
      "arguments": [
        {
          "name": "APNUMBER",
          "value": "11"
        },
        {
          "name": "NEWAPSTATE",
          "value": "LC_APSTATE_ACTIVE"
        }
      ]
    },
    {
      "type": "command",
      "name": "/LC/LC_COMMANDS/LC_RESET_AP_STATS",
      "extraOptions": [],
      "arguments": [
        {
          "name": "APNUMBER",
          "value": "11"
        },
        {
          "name": "PADDING",
          "value": "0"
        }
      ]
    }
  ],
  "advancement": {
    "acknowledgment": "Acknowledge_Queued",
    "wait": 0
  }
}