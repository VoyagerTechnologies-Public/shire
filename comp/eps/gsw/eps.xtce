<?xml version="1.0" encoding="UTF-8"?>
<xtce:SpaceSystem xmlns:xtce="http://www.omg.org/spec/XTCE/20180204" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="EPS" xsi:schemaLocation="http://www.omg.org/spec/XTCE/20180204 https://www.omg.org/spec/XTCE/20180204/SpaceSystem.xsd">
  <xtce:TelemetryMetaData>
    <xtce:ParameterTypeSet>
      <xtce:IntegerParameterType name="CMD_ERR_COUNT_Type" shortDescription="Command Error Count" signed="false">
        <xtce:IntegerDataEncoding sizeInBits="8" encoding="unsigned"/>
      </xtce:IntegerParameterType>
      <xtce:IntegerParameterType name="CMD_COUNT_Type" shortDescription="Command Count" signed="false">
        <xtce:IntegerDataEncoding sizeInBits="16" encoding="unsigned" byteOrder="leastSignificantByteFirst"/>
      </xtce:IntegerParameterType>
      <xtce:IntegerParameterType name="DEVICE_ERR_COUNT_Type" shortDescription="Device Command Error Count" signed="false">
        <xtce:IntegerDataEncoding sizeInBits="8" encoding="unsigned"/>
      </xtce:IntegerParameterType>
      <xtce:IntegerParameterType name="DEVICE_COUNT_Type" shortDescription="Device Command Count" signed="false">
        <xtce:IntegerDataEncoding sizeInBits="16" encoding="unsigned" byteOrder="leastSignificantByteFirst"/>
      </xtce:IntegerParameterType>
      <xtce:FloatParameterType name="BATTERY_VOLTAGE_Type" shortDescription="Battery Voltage (32V/255 scale)">
        <xtce:IntegerDataEncoding sizeInBits="8" encoding="unsigned">
          <xtce:DefaultCalibrator>
            <xtce:PolynomialCalibrator>
              <xtce:Term coefficient="0.12549" exponent="1"/>
            </xtce:PolynomialCalibrator>
          </xtce:DefaultCalibrator>
        </xtce:IntegerDataEncoding>
        <xtce:UnitSet>
          <xtce:Unit>V</xtce:Unit>
        </xtce:UnitSet>
      </xtce:FloatParameterType>
      <xtce:FloatParameterType name="BATTERY_TEMPERATURE_Type" shortDescription="Battery Temperature (250C/255 scale)">
        <xtce:IntegerDataEncoding sizeInBits="8" encoding="unsigned">
          <xtce:DefaultCalibrator>
            <xtce:PolynomialCalibrator>
              <xtce:Term coefficient="0.9804" exponent="1"/>
            </xtce:PolynomialCalibrator>
          </xtce:DefaultCalibrator>
        </xtce:IntegerDataEncoding>
        <xtce:UnitSet>
          <xtce:Unit>°C</xtce:Unit>
        </xtce:UnitSet>
      </xtce:FloatParameterType>
      <xtce:FloatParameterType name="SOLAR_VOLTAGE_Type" shortDescription="Solar Voltage (32V/255 scale)">
        <xtce:IntegerDataEncoding sizeInBits="8" encoding="unsigned">
          <xtce:DefaultCalibrator>
            <xtce:PolynomialCalibrator>
              <xtce:Term coefficient="0.125" exponent="1"/>
            </xtce:PolynomialCalibrator>
          </xtce:DefaultCalibrator>
        </xtce:IntegerDataEncoding>
        <xtce:UnitSet>
          <xtce:Unit>V</xtce:Unit>
        </xtce:UnitSet>
      </xtce:FloatParameterType>
      <xtce:FloatParameterType name="SOLAR_TEMPERATURE_Type" shortDescription="Solar Temperature (250C/255 scale)">
        <xtce:IntegerDataEncoding sizeInBits="8" encoding="unsigned">
          <xtce:DefaultCalibrator>
            <xtce:PolynomialCalibrator>
              <xtce:Term coefficient="0.9804" exponent="1"/>
            </xtce:PolynomialCalibrator>
          </xtce:DefaultCalibrator>
        </xtce:IntegerDataEncoding>
        <xtce:UnitSet>
          <xtce:Unit>°C</xtce:Unit>
        </xtce:UnitSet>
      </xtce:FloatParameterType>
      <xtce:EnumeratedParameterType name="SWITCH_STATE_Type" shortDescription="Switch State">
        <xtce:IntegerDataEncoding sizeInBits="8" encoding="unsigned"/>
        <xtce:EnumerationList>
          <xtce:Enumeration value="0" label="OFF"/>
          <xtce:Enumeration value="1" label="ON"/>
        </xtce:EnumerationList>
      </xtce:EnumeratedParameterType>
      <xtce:FloatParameterType name="SWITCH_VOLTAGE_Type" shortDescription="Switch Voltage (32V/255 scale)">
        <xtce:IntegerDataEncoding sizeInBits="8" encoding="unsigned">
          <xtce:DefaultCalibrator>
            <xtce:PolynomialCalibrator>
              <xtce:Term coefficient="0.125" exponent="1"/>
            </xtce:PolynomialCalibrator>
          </xtce:DefaultCalibrator>
        </xtce:IntegerDataEncoding>
        <xtce:UnitSet>
          <xtce:Unit>V</xtce:Unit>
        </xtce:UnitSet>
      </xtce:FloatParameterType>
      <xtce:FloatParameterType name="SWITCH_CURRENT_Type" shortDescription="Switch Current (10A/255 scale)">
        <xtce:IntegerDataEncoding sizeInBits="8" encoding="unsigned">
          <xtce:DefaultCalibrator>
            <xtce:PolynomialCalibrator>
              <xtce:Term coefficient="0.0392" exponent="1"/>
            </xtce:PolynomialCalibrator>
          </xtce:DefaultCalibrator>
        </xtce:IntegerDataEncoding>
        <xtce:UnitSet>
          <xtce:Unit>A</xtce:Unit>
        </xtce:UnitSet>
      </xtce:FloatParameterType>
      <xtce:IntegerParameterType name="CRC_Type" shortDescription="CRC-8-CCITT" signed="false">
        <xtce:IntegerDataEncoding sizeInBits="8" encoding="unsigned"/>
      </xtce:IntegerParameterType>
    </xtce:ParameterTypeSet>
    <xtce:ParameterSet>
      <xtce:Parameter name="CMD_ERR_COUNT" parameterTypeRef="CMD_ERR_COUNT_Type"/>
      <xtce:Parameter name="CMD_COUNT" parameterTypeRef="CMD_COUNT_Type"/>
      <xtce:Parameter name="DEVICE_ERR_COUNT" parameterTypeRef="DEVICE_ERR_COUNT_Type"/>
      <xtce:Parameter name="DEVICE_COUNT" parameterTypeRef="DEVICE_COUNT_Type"/>
      <xtce:Parameter name="BATTERY_VOLTAGE" parameterTypeRef="BATTERY_VOLTAGE_Type"/>
      <xtce:Parameter name="BATTERY_TEMPERATURE" parameterTypeRef="BATTERY_TEMPERATURE_Type"/>
      <xtce:Parameter name="SOLAR_VOLTAGE" parameterTypeRef="SOLAR_VOLTAGE_Type"/>
      <xtce:Parameter name="SOLAR_TEMPERATURE" parameterTypeRef="SOLAR_TEMPERATURE_Type"/>
      <xtce:Parameter name="SWITCH_0_STATE" parameterTypeRef="SWITCH_STATE_Type"/>
      <xtce:Parameter name="SWITCH_0_VOLTAGE" parameterTypeRef="SWITCH_VOLTAGE_Type"/>
      <xtce:Parameter name="SWITCH_0_CURRENT" parameterTypeRef="SWITCH_CURRENT_Type"/>
      <xtce:Parameter name="SWITCH_1_STATE" parameterTypeRef="SWITCH_STATE_Type"/>
      <xtce:Parameter name="SWITCH_1_VOLTAGE" parameterTypeRef="SWITCH_VOLTAGE_Type"/>
      <xtce:Parameter name="SWITCH_1_CURRENT" parameterTypeRef="SWITCH_CURRENT_Type"/>
      <xtce:Parameter name="SWITCH_2_STATE" parameterTypeRef="SWITCH_STATE_Type"/>
      <xtce:Parameter name="SWITCH_2_VOLTAGE" parameterTypeRef="SWITCH_VOLTAGE_Type"/>
      <xtce:Parameter name="SWITCH_2_CURRENT" parameterTypeRef="SWITCH_CURRENT_Type"/>
      <xtce:Parameter name="SWITCH_3_STATE" parameterTypeRef="SWITCH_STATE_Type"/>
      <xtce:Parameter name="SWITCH_3_VOLTAGE" parameterTypeRef="SWITCH_VOLTAGE_Type"/>
      <xtce:Parameter name="SWITCH_3_CURRENT" parameterTypeRef="SWITCH_CURRENT_Type"/>
      <xtce:Parameter name="SWITCH_4_STATE" parameterTypeRef="SWITCH_STATE_Type"/>
      <xtce:Parameter name="SWITCH_4_VOLTAGE" parameterTypeRef="SWITCH_VOLTAGE_Type"/>
      <xtce:Parameter name="SWITCH_4_CURRENT" parameterTypeRef="SWITCH_CURRENT_Type"/>
      <xtce:Parameter name="SWITCH_5_STATE" parameterTypeRef="SWITCH_STATE_Type"/>
      <xtce:Parameter name="SWITCH_5_VOLTAGE" parameterTypeRef="SWITCH_VOLTAGE_Type"/>
      <xtce:Parameter name="SWITCH_5_CURRENT" parameterTypeRef="SWITCH_CURRENT_Type"/>
      <xtce:Parameter name="SWITCH_6_STATE" parameterTypeRef="SWITCH_STATE_Type"/>
      <xtce:Parameter name="SWITCH_6_VOLTAGE" parameterTypeRef="SWITCH_VOLTAGE_Type"/>
      <xtce:Parameter name="SWITCH_6_CURRENT" parameterTypeRef="SWITCH_CURRENT_Type"/>
      <xtce:Parameter name="SWITCH_7_STATE" parameterTypeRef="SWITCH_STATE_Type"/>
      <xtce:Parameter name="SWITCH_7_VOLTAGE" parameterTypeRef="SWITCH_VOLTAGE_Type"/>
      <xtce:Parameter name="SWITCH_7_CURRENT" parameterTypeRef="SWITCH_CURRENT_Type"/>
      <xtce:Parameter name="DEVICE_HK_CRC" parameterTypeRef="CRC_Type"/>
    </xtce:ParameterSet>
    <xtce:ContainerSet>
      <xtce:SequenceContainer name="EPS_HK_TLM" shortDescription="EPS_Hk_tlm_t">
        <xtce:EntryList>
          <xtce:ParameterRefEntry parameterRef="CMD_ERR_COUNT"/>
          <xtce:ParameterRefEntry parameterRef="CMD_COUNT"/>
          <xtce:ParameterRefEntry parameterRef="DEVICE_ERR_COUNT"/>
          <xtce:ParameterRefEntry parameterRef="DEVICE_COUNT"/>
          <xtce:ParameterRefEntry parameterRef="BATTERY_VOLTAGE"/>
          <xtce:ParameterRefEntry parameterRef="BATTERY_TEMPERATURE"/>
          <xtce:ParameterRefEntry parameterRef="SOLAR_VOLTAGE"/>
          <xtce:ParameterRefEntry parameterRef="SOLAR_TEMPERATURE"/>
          <xtce:ParameterRefEntry parameterRef="SWITCH_0_STATE"/>
          <xtce:ParameterRefEntry parameterRef="SWITCH_0_VOLTAGE"/>
          <xtce:ParameterRefEntry parameterRef="SWITCH_0_CURRENT"/>
          <xtce:ParameterRefEntry parameterRef="SWITCH_1_STATE"/>
          <xtce:ParameterRefEntry parameterRef="SWITCH_1_VOLTAGE"/>
          <xtce:ParameterRefEntry parameterRef="SWITCH_1_CURRENT"/>
          <xtce:ParameterRefEntry parameterRef="SWITCH_2_STATE"/>
          <xtce:ParameterRefEntry parameterRef="SWITCH_2_VOLTAGE"/>
          <xtce:ParameterRefEntry parameterRef="SWITCH_2_CURRENT"/>
          <xtce:ParameterRefEntry parameterRef="SWITCH_3_STATE"/>
          <xtce:ParameterRefEntry parameterRef="SWITCH_3_VOLTAGE"/>
          <xtce:ParameterRefEntry parameterRef="SWITCH_3_CURRENT"/>
          <xtce:ParameterRefEntry parameterRef="SWITCH_4_STATE"/>
          <xtce:ParameterRefEntry parameterRef="SWITCH_4_VOLTAGE"/>
          <xtce:ParameterRefEntry parameterRef="SWITCH_4_CURRENT"/>
          <xtce:ParameterRefEntry parameterRef="SWITCH_5_STATE"/>
          <xtce:ParameterRefEntry parameterRef="SWITCH_5_VOLTAGE"/>
          <xtce:ParameterRefEntry parameterRef="SWITCH_5_CURRENT"/>
          <xtce:ParameterRefEntry parameterRef="SWITCH_6_STATE"/>
          <xtce:ParameterRefEntry parameterRef="SWITCH_6_VOLTAGE"/>
          <xtce:ParameterRefEntry parameterRef="SWITCH_6_CURRENT"/>
          <xtce:ParameterRefEntry parameterRef="SWITCH_7_STATE"/>
          <xtce:ParameterRefEntry parameterRef="SWITCH_7_VOLTAGE"/>
          <xtce:ParameterRefEntry parameterRef="SWITCH_7_CURRENT"/>
          <xtce:ParameterRefEntry parameterRef="DEVICE_HK_CRC"/>
        </xtce:EntryList>
        <xtce:BaseContainer containerRef="/CCSDS/CCSDS_TM">
          <xtce:RestrictionCriteria>
            <xtce:ComparisonList>
              <xtce:Comparison parameterRef="/CCSDS/CCSDS_STREAMID" value="0x08D0"/>
            </xtce:ComparisonList>
          </xtce:RestrictionCriteria>
        </xtce:BaseContainer>
      </xtce:SequenceContainer>
    </xtce:ContainerSet>
  </xtce:TelemetryMetaData>
  <xtce:CommandMetaData>
    <xtce:ArgumentTypeSet>
      <xtce:IntegerArgumentType name="SWITCH_NUMBER_Type" initialValue="0" shortDescription="Switch Number (0-7)" signed="false">
        <xtce:IntegerDataEncoding sizeInBits="8" encoding="unsigned"/>
        <xtce:ValidRange minInclusive="0" maxInclusive="7"/>
      </xtce:IntegerArgumentType>
    </xtce:ArgumentTypeSet>
    <xtce:MetaCommandSet>
      <xtce:MetaCommand name="EPS_REQ_HK">
        <xtce:BaseMetaCommand metaCommandRef="/CCSDS/CCSDS_TC">
          <xtce:ArgumentAssignmentList>
            <xtce:ArgumentAssignment argumentName="CCSDS_STREAMID" argumentValue="0x18D1"/>
            <xtce:ArgumentAssignment argumentName="CCSDS_FC" argumentValue="0"/>
          </xtce:ArgumentAssignmentList>
        </xtce:BaseMetaCommand>
        <xtce:ArgumentList/>
        <xtce:CommandContainer name="EPS_REQ_HK_CommandContainer">
          <xtce:EntryList/>
        </xtce:CommandContainer>
      </xtce:MetaCommand>
      <xtce:MetaCommand name="EPS_SWITCH_ON_CC">
        <xtce:BaseMetaCommand metaCommandRef="/CCSDS/CCSDS_TC">
          <xtce:ArgumentAssignmentList>
            <xtce:ArgumentAssignment argumentName="CCSDS_STREAMID" argumentValue="0x18D0"/>
            <xtce:ArgumentAssignment argumentName="CCSDS_FC" argumentValue="3"/>
          </xtce:ArgumentAssignmentList>
        </xtce:BaseMetaCommand>
        <xtce:ArgumentList>
          <xtce:Argument name="SWITCH_NUMBER" argumentTypeRef="SWITCH_NUMBER_Type"/>
        </xtce:ArgumentList>
        <xtce:CommandContainer name="EPS_SWITCH_ON_CC_CommandContainer">
          <xtce:EntryList>
            <xtce:ArgumentRefEntry argumentRef="SWITCH_NUMBER"/>
          </xtce:EntryList>
        </xtce:CommandContainer>
      </xtce:MetaCommand>
      <xtce:MetaCommand name="EPS_SWITCH_OFF_CC">
        <xtce:BaseMetaCommand metaCommandRef="/CCSDS/CCSDS_TC">
          <xtce:ArgumentAssignmentList>
            <xtce:ArgumentAssignment argumentName="CCSDS_STREAMID" argumentValue="0x18D0"/>
            <xtce:ArgumentAssignment argumentName="CCSDS_FC" argumentValue="2"/>
          </xtce:ArgumentAssignmentList>
        </xtce:BaseMetaCommand>
        <xtce:ArgumentList>
          <xtce:Argument name="SWITCH_NUMBER" argumentTypeRef="SWITCH_NUMBER_Type"/>
        </xtce:ArgumentList>
        <xtce:CommandContainer name="EPS_SWITCH_OFF_CC_CommandContainer">
          <xtce:EntryList>
            <xtce:ArgumentRefEntry argumentRef="SWITCH_NUMBER"/>
          </xtce:EntryList>
        </xtce:CommandContainer>
      </xtce:MetaCommand>
      <xtce:MetaCommand name="EPS_RST_COUNTERS_CC">
        <xtce:BaseMetaCommand metaCommandRef="/CCSDS/CCSDS_TC">
          <xtce:ArgumentAssignmentList>
            <xtce:ArgumentAssignment argumentName="CCSDS_STREAMID" argumentValue="0x18D0"/>
            <xtce:ArgumentAssignment argumentName="CCSDS_FC" argumentValue="1"/>
          </xtce:ArgumentAssignmentList>
        </xtce:BaseMetaCommand>
        <xtce:ArgumentList/>
        <xtce:CommandContainer name="EPS_RST_COUNTERS_CC_CommandContainer">
          <xtce:EntryList/>
        </xtce:CommandContainer>
      </xtce:MetaCommand>
      <xtce:MetaCommand name="EPS_NOOP_CC">
        <xtce:BaseMetaCommand metaCommandRef="/CCSDS/CCSDS_TC">
          <xtce:ArgumentAssignmentList>
            <xtce:ArgumentAssignment argumentName="CCSDS_STREAMID" argumentValue="0x18D0"/>
            <xtce:ArgumentAssignment argumentName="CCSDS_FC" argumentValue="0"/>
          </xtce:ArgumentAssignmentList>
        </xtce:BaseMetaCommand>
        <xtce:ArgumentList/>
        <xtce:CommandContainer name="EPS_NOOP_CC_CommandContainer">
          <xtce:EntryList/>
        </xtce:CommandContainer>
      </xtce:MetaCommand>
    </xtce:MetaCommandSet>
  </xtce:CommandMetaData>
</xtce:SpaceSystem>
