{
  "$schema": "https://yamcs.org/schema/stack.schema.json",
  "steps": [
    {
      "type": "command",
      "name": "/EPS/EPS_RST_COUNTERS_CC",
      "extraOptions": [],
      "arguments": []
    },
    {
      "type": "command",
      "name": "/EPS/EPS_REQ_HK",
      "extraOptions": [],
      "arguments": []
    },
    {
      "type": "verify",
      "condition": [
        {
          "parameter": "/EPS/CMD_COUNT",
          "operator": "eq",
          "value": "0"
        }
      ]
    },
    {
      "type": "command",
      "name": "/EPS/EPS_NOOP_CC",
      "extraOptions": [],
      "arguments": []
    },
    {
      "type": "command",
      "name": "/EPS/EPS_REQ_HK",
      "extraOptions": [],
      "arguments": []
    },
    {
      "type": "verify",
      "condition": [
        {
          "parameter": "/EPS/CMD_COUNT",
          "operator": "eq",
          "value": "1"
        }
      ]
    }
  ],
  "advancement": {
    "acknowledgment": "Acknowledge_Queued",
    "wait": 1000
  }
}