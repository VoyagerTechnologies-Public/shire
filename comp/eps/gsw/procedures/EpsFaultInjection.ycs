{
  "$schema": "https://yamcs.org/schema/stack.schema.json",
  "steps": [
    {
      "type": "text",
      "text": "Before running in Yamcs Links: enable debug-in and sim-backdoor. Keep the simulation playing. This stack selects debug-out and disables radio-out automatically for normal EPS and device commands. Keep radio-out disabled throughout this stack.",
      "comment": "Before running in Yamcs Links: enable debug-in and sim-backdoor. Keep the simulation playing. This stack selects debug-out and disables radio-out automatically for normal EPS and device commands. Keep radio-out disabled throughout this stack."
    },
    {
      "type": "command",
      "name": "/SHIRE_GROUND/USE_DEBUG_UPLINK",
      "arguments": [],
      "extraOptions": []
    },
    {
      "type": "text",
      "text": "FAULT_BEGIN",
      "comment": "FAULT_BEGIN"
    },
    {
      "type": "command",
      "name": "/EPS/BACKDOOR_EPS_CLEAR_FAULTS",
      "arguments": [],
      "extraOptions": []
    },
    {
      "type": "text",
      "text": "Debug-path preflight briefly cuts radio supply. If the next check fails, enable debug-in/debug-out and disable radio-out before restarting this stack.",
      "comment": "Debug-path preflight briefly cuts radio supply. If the next check fails, enable debug-in/debug-out and disable radio-out before restarting this stack."
    },
    {
      "type": "command",
      "name": "/EPS/BACKDOOR_EPS_SET_SWITCH",
      "arguments": [
        {
          "name": "SWITCH",
          "value": "6"
        },
        {
          "name": "STATE",
          "value": "0"
        }
      ],
      "extraOptions": []
    },
    {
      "type": "command",
      "name": "/EPS/EPS_REQ_HK",
      "arguments": [],
      "extraOptions": []
    },
    {
      "type": "verify",
      "comment": "debug path required: fresh EPS housekeeping while radio is off",
      "timeout": 5000,
      "condition": [
        {
          "parameter": "/EPS/SWITCH_6_STATE",
          "operator": "eq",
          "value": "OFF"
        }
      ]
    },
    {
      "type": "command",
      "name": "/EPS/EPS_RST_COUNTERS_CC",
      "arguments": [],
      "extraOptions": []
    },
    {
      "type": "command",
      "name": "/EPS/EPS_REQ_HK",
      "arguments": [],
      "extraOptions": []
    },
    {
      "type": "verify",
      "comment": "debug flight command baseline",
      "timeout": 5000,
      "condition": [
        {
          "parameter": "/EPS/CMD_COUNT",
          "operator": "eq",
          "value": "0"
        }
      ]
    },
    {
      "type": "command",
      "name": "/EPS/EPS_NOOP_CC",
      "arguments": [],
      "extraOptions": []
    },
    {
      "type": "command",
      "name": "/EPS/EPS_REQ_HK",
      "arguments": [],
      "extraOptions": []
    },
    {
      "type": "verify",
      "comment": "debug flight command received while radio is off",
      "timeout": 5000,
      "condition": [
        {
          "parameter": "/EPS/CMD_COUNT",
          "operator": "eq",
          "value": "1"
        }
      ]
    },
    {
      "type": "command",
      "name": "/EPS/EPS_SWITCH_ON_CC",
      "arguments": [
        {
          "name": "SWITCH_NUMBER",
          "value": "6"
        }
      ],
      "extraOptions": []
    },
    {
      "type": "command",
      "name": "/EPS/EPS_REQ_HK",
      "arguments": [],
      "extraOptions": []
    },
    {
      "type": "verify",
      "comment": "rail 6 on",
      "timeout": 30000,
      "condition": [
        {
          "parameter": "/EPS/SWITCH_6_STATE",
          "operator": "eq",
          "value": "ON"
        }
      ]
    },
    {
      "type": "command",
      "name": "/EPS/EPS_SWITCH_ON_CC",
