      "timeout": 30000,
      "condition": [
        {
          "parameter": "/EPS/CMD_COUNT",
          "operator": "eq",
          "value": "1"
        }
      ]
    },
    {
      "type": "text",
      "text": "OUTAGE_END",
      "comment": "OUTAGE_END"
    },
