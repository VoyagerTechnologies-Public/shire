{
  "$schema": "https://yamcs.org/schema/stack.schema.json",
  "steps": [
    {
      "type": "text",
      "text": "Before running in Yamcs Links: enable debug-in and sim-backdoor. Keep the simulation playing. This stack selects debug-out and disables radio-out automatically for normal EPS and device commands. Keep radio-out disabled throughout this stack.",
      "comment": "Before running in Yamcs Links: enable debug-in and sim-backdoor. Keep the simulation playing. This stack selects debug-out and disables radio-out automatically for normal EPS and device commands. Keep radio-out disabled throughout this stack."
    },
    {
      "type": "command",
      "name": "/SHIRE_GROUND/USE_DEBUG_UPLINK",
      "arguments": [],
      "extraOptions": []
    },
    {
      "type": "text",
      "text": "EPS backdoors: confirm effects in fresh FSW telemetry; no retries",
      "comment": "EPS backdoors: confirm effects in fresh FSW telemetry; no retries"
    },
    {
      "type": "text",
      "text": "OUTAGE_BEGIN",
      "comment": "OUTAGE_BEGIN"
    },
    {
      "type": "command",
      "name": "/EPS/EPS_SWITCH_ON_CC",
      "arguments": [
        {
          "name": "SWITCH_NUMBER",
          "value": "0"
        }
      ],
      "extraOptions": []
    },
    {
      "type": "command",
      "name": "/EPS/EPS_SWITCH_ON_CC",
      "arguments": [
        {
          "name": "SWITCH_NUMBER",
          "value": "4"
        }
      ],
      "extraOptions": []
    },
    {
      "type": "command",
      "name": "/EPS/EPS_SWITCH_ON_CC",
      "arguments": [
        {
          "name": "SWITCH_NUMBER",
          "value": "6"
        }
      ],
      "extraOptions": []
    },
    {
      "type": "command",
      "name": "/DEMO/DEMO_REQ_HK",
      "arguments": [],
      "extraOptions": []
    },
    {
      "type": "command",
      "name": "/DEMO/DEMO_ENABLE_CC",
      "arguments": [],
      "extraOptions": [],
      "comment": "Enable if disabled: /DEMO/DEVICE_ENABLED"
    },
    {
      "type": "command",
      "name": "/ADCS/ADCS_REQ_HK",
      "arguments": [],
      "extraOptions": []
    },
    {
      "type": "command",
      "name": "/ADCS/ADCS_ENABLE_CC",
      "arguments": [],
      "extraOptions": [],
      "comment": "Enable if disabled: /ADCS/DEVICE_ENABLED"
    },
    {
      "type": "command",
      "name": "/RADIO/RADIO_REQ_HK",
      "arguments": [],
      "extraOptions": []
    },
    {
      "type": "verify",
      "comment": "DRM radio startup enabled",
      "timeout": 30000,
      "condition": [
        {
          "parameter": "/RADIO/RADIO_HK_DeviceEnabled",
          "operator": "eq",
          "value": "1"
        }
      ]
    },
    {
      "type": "command",
      "name": "/DEMO/DEMO_REQ_HK",
      "arguments": [],
      "extraOptions": []
    },
    {
      "type": "command",
      "name": "/ADCS/ADCS_REQ_HK",
      "arguments": [],
      "extraOptions": []
    },
    {
      "type": "command",
      "name": "/RADIO/RADIO_REQ_HK",
      "arguments": [],
      "extraOptions": []
    },
