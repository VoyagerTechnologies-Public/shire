{
  "$schema": "https://yamcs.org/schema/stack.schema.json",
  "steps": [
    {
      "type": "text",
      "text": "Before running in Yamcs Links: enable debug-in and sim-backdoor. Keep the simulation playing. This stack selects debug-out and disables radio-out automatically for normal EPS and device commands. This stack automatically selects radio-out for each marked RF probe and restores the prior command-link states before requesting housekeeping.",
      "comment": "Before running in Yamcs Links: enable debug-in and sim-backdoor. Keep the simulation playing. This stack selects debug-out and disables radio-out automatically for normal EPS and device commands. This stack automatically selects radio-out for each marked RF probe and restores the prior command-link states before requesting housekeeping."
    },
    {
      "type": "command",
      "name": "/SHIRE_GROUND/USE_DEBUG_UPLINK",
      "arguments": [],
      "extraOptions": []
    },
    {
      "type": "text",
      "text": "EPS functional: resolved wiring; switch effects use flight commands",
      "comment": "EPS functional: resolved wiring; switch effects use flight commands"
    },
    {
      "type": "text",
      "text": "OUTAGE_BEGIN",
      "comment": "OUTAGE_BEGIN"
    },
    {
      "type": "command",
      "name": "/EPS/EPS_SWITCH_ON_CC",
      "arguments": [
        {
          "name": "SWITCH_NUMBER",
          "value": "0"
        }
      ],
      "extraOptions": []
    },
    {
      "type": "command",
      "name": "/EPS/EPS_SWITCH_ON_CC",
      "arguments": [
        {
          "name": "SWITCH_NUMBER",
          "value": "4"
        }
      ],
      "extraOptions": []
    },
    {
      "type": "command",
      "name": "/EPS/EPS_SWITCH_ON_CC",
      "arguments": [
        {
          "name": "SWITCH_NUMBER",
          "value": "6"
        }
      ],
      "extraOptions": []
    },
    {
      "type": "command",
      "name": "/DEMO/DEMO_REQ_HK",
      "arguments": [],
      "extraOptions": []
    },
    {
      "type": "command",
      "name": "/DEMO/DEMO_ENABLE_CC",
      "arguments": [],
      "extraOptions": [],
      "comment": "Enable if disabled: /DEMO/DEVICE_ENABLED"
    },
    {
      "type": "command",
      "name": "/ADCS/ADCS_REQ_HK",
      "arguments": [],
      "extraOptions": []
    },
    {
      "type": "command",
      "name": "/ADCS/ADCS_ENABLE_CC",
      "arguments": [],
      "extraOptions": [],
      "comment": "Enable if disabled: /ADCS/DEVICE_ENABLED"
    },
    {
      "type": "command",
      "name": "/RADIO/RADIO_REQ_HK",
      "arguments": [],
      "extraOptions": []
    },
    {
      "type": "verify",
      "comment": "DRM radio startup enabled",
      "timeout": 30000,
      "condition": [
        {
          "parameter": "/RADIO/RADIO_HK_DeviceEnabled",
          "operator": "eq",
          "value": "1"
        }
      ]
    },
    {
      "type": "command",
      "name": "/DEMO/DEMO_REQ_HK",
      "arguments": [],
      "extraOptions": []
    },
    {
      "type": "command",
      "name": "/ADCS/ADCS_REQ_HK",
      "arguments": [],
      "extraOptions": []
    },
    {
      "type": "command",
      "name": "/RADIO/RADIO_REQ_HK",
      "arguments": [],
      "extraOptions": []
    },
    {
      "type": "command",
      "name": "/ADCS/ADCS_REQ_HK",
      "arguments": [],
      "extraOptions": []
    },
    {
      "type": "command",
      "name": "/DEMO/DEMO_REQ_HK",
      "arguments": [],
      "extraOptions": []
    },
    {
      "type": "command",
      "name": "/RADIO/RADIO_REQ_HK",
      "arguments": [],
      "extraOptions": []
    },
    {
      "type": "verify",
      "comment": "fresh device transactions",
      "timeout": 30000,
      "condition": [
        {
          "parameter": "/DEMO/DEVICE_COUNT",
          "operator": "gt",
          "value": "0"
        },
        {
          "parameter": "/ADCS/DEVICE_COUNT",
          "operator": "gt",
          "value": "0"
        },
        {
          "parameter": "/RADIO/RADIO_HK_DeviceCount",
          "operator": "gt",
          "value": "0"
        }
      ]
    },
    {
      "type": "command",
      "name": "/RADIO/RADIO_CONFIG_CC",
      "arguments": [
        {
          "name": "MODE",
          "value": "Duplex Mode"
        }
      ],
      "extraOptions": []
    },
    {
      "type": "command",
      "name": "/EPS/EPS_RST_COUNTERS_CC",
      "arguments": [],
      "extraOptions": []
    },
    {
      "type": "command",
      "name": "/EPS/EPS_REQ_HK",
      "arguments": [],
      "extraOptions": []
    },
    {
      "type": "verify",
      "comment": "EPS counters for RF probe",
      "timeout": 30000,
      "condition": [
        {
          "parameter": "/EPS/CMD_COUNT",
          "operator": "eq",
          "value": "0"
        }
      ]
    },
    {
      "type": "text",
      "text": "RF probe: Yamcs ground commands select radio-out exclusively for the following EPS flight NOOP, then restore the previous uplink states. Keep the simulation playing; no manual link changes are needed.",
      "comment": "RF probe: Yamcs ground commands select radio-out exclusively for the following EPS flight NOOP, then restore the previous uplink states. Keep the simulation playing; no manual link changes are needed."
    },
    {
      "type": "command",
      "name": "/SHIRE_GROUND/USE_RADIO_UPLINK",
      "arguments": [],
      "extraOptions": []
    },
    {
      "type": "command",
      "name": "/EPS/EPS_NOOP_CC",
      "arguments": [],
      "extraOptions": [],
      "comment": "EPS RF probe via radio-out"
    },
    {
      "type": "command",
      "name": "/SHIRE_GROUND/RESTORE_UPLINK",
      "arguments": [],
      "extraOptions": []
    },
    {
      "type": "command",
      "name": "/EPS/EPS_REQ_HK",
      "arguments": [],
      "extraOptions": []
    },
    {
      "type": "command",
      "name": "/RADIO/RADIO_REQ_HK",
      "arguments": [],
      "extraOptions": []
    },
    {
      "type": "verify",
      "comment": "radio uplink and downlink observed",
      "timeout": 30000,
      "condition": [
        {
          "parameter": "/EPS/CMD_COUNT",
          "operator": "eq",
          "value": "1"
        },
        {
          "parameter": "/RADIO/RADIO_DEVICE_BytesReceived",
          "operator": "gt",
          "value": "0"
        },
        {
          "parameter": "/RADIO/RADIO_DEVICE_BytesSent",
          "operator": "gt",
          "value": "0"
        }
      ]
    },
    {
      "type": "text",
      "text": "OUTAGE_END",
      "comment": "OUTAGE_END"
    },
    {
      "type": "text",
      "text": "OUTAGE_BEGIN",
      "comment": "OUTAGE_BEGIN"
    },
    {
      "type": "command",
      "name": "/EPS/EPS_SWITCH_OFF_CC",
