# SHIRE Base Dockerfile
# Build environment for SHIRE FSW, Simulith, and components.
# Published to: ghcr.io/voyagertechnologies-public/shire-base
#
# Local, native-platform build: make container (from repo root)
#
# Publish a multi-platform image to your own GHCR namespace (from repo root):
#   1. Create a GitHub token with write:packages, then use it as the password for:
#        docker login ghcr.io -u YOUR_GITHUB_USER
#   2. Create and bootstrap a multi-platform builder (one time):
#        docker buildx create --name shire-multiarch --driver docker-container --use
#        docker buildx inspect --bootstrap
#   3. Build and push the image plus its multi-platform manifest:
#        export IMAGE=ghcr.io/voyagertechnologies-public/shire-base
#        docker buildx build --platform linux/amd64,linux/arm64 \
#          --tag "${IMAGE}:0.0.0" --push -f tools/Dockerfile.base tools
#   4. Verify the published platforms:
#        docker buildx imagetools inspect "${IMAGE}:0.0.0"
#

FROM debian:trixie-slim@sha256:a99cfc517144bc59b1978475ec53b46ecabec7e43635402ee5b77cc54cd1b20a

ENV DEBIAN_FRONTEND=noninteractive

LABEL org.opencontainers.image.title="shire-base" \
      org.opencontainers.image.description="Build and development environment for SHIRE" \
      org.opencontainers.image.source="https://github.com/VoyagerTechnologies-Public/shire" \
      org.opencontainers.image.vendor="Voyager Technologies"

# Install all build and dev tools in a single layer:
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    curl \
    gdb \
    git \
    lcov \
    libcurl4-openssl-dev \
    libgcrypt20-dev \
    libjson-xs-perl \
    libsocketcan-dev \
    libsqlite3-dev \
    libzmq3-dev \
    pmccabe \
    pkg-config \
    python3 \
    python3-pip \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# QCBOR (BSD-3-Clause) is required by BPLib and is not packaged in Debian trixie. The release tag is verified against
# a pinned commit, and the library is built static and position independent so it links into BPLib's shared module.
ARG QCBOR_VERSION=v1.5.1
ARG QCBOR_COMMIT=f9175730ccd361a10a466093ce1db8231ce409e9
RUN git clone --branch ${QCBOR_VERSION} https://github.com/laurencelundblade/QCBOR.git /tmp/qcbor && \
    test "$(git -C /tmp/qcbor rev-parse HEAD)" = "${QCBOR_COMMIT}" && \
    cmake -S /tmp/qcbor -B /tmp/qcbor/build -DBUILD_SHARED_LIBS=OFF -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
      -DCMAKE_BUILD_TYPE=Release && \
    cmake --build /tmp/qcbor/build -j"$(nproc)" && \
    cmake --install /tmp/qcbor/build && \
    rm -rf /tmp/qcbor

# Fail the image build if the compiler/LCOV pair cannot emit MC/DC records.
RUN printf '%s\n' \
      'int covered(int a, int b, int c) { return a && (b || c); }' \
      'int main(void) { covered(1, 1, 0); covered(0, 0, 1); return 0; }' \
      > /tmp/shire-mcdc-smoke.c && \
    gcc -O0 --coverage -fcondition-coverage \
      /tmp/shire-mcdc-smoke.c -o /tmp/shire-mcdc-smoke && \
    /tmp/shire-mcdc-smoke && \
    lcov --capture --directory /tmp --branch-coverage --mcdc-coverage \
      --output-file /tmp/shire-mcdc-smoke.info >/dev/null && \
    grep -q '^MCDC:' /tmp/shire-mcdc-smoke.info && \
    rm -f /tmp/shire-mcdc-smoke /tmp/shire-mcdc-smoke.c \
      /tmp/shire-mcdc-smoke.gcda /tmp/shire-mcdc-smoke.gcno \
      /tmp/shire-mcdc-smoke.info

# Install orchestrator requirements
COPY requirements.txt /requirements.txt
RUN pip3 install --break-system-packages --no-cache-dir -r /requirements.txt

# Create developer user (UID/GID 1000 by default; override with --build-arg for local dev)
ARG USER_ID=1000
ARG GROUP_ID=1000
RUN if ! getent group ${GROUP_ID} > /dev/null 2>&1; then \
        groupadd -g ${GROUP_ID} developer; \
    fi && \
    useradd -u ${USER_ID} -g ${GROUP_ID} -m -s /bin/bash shire
