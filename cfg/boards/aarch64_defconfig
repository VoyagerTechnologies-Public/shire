# Processor PIL userspace only: use the physical board's existing Linux kernel.
BR2_aarch64=y
BR2_ARM64_PAGE_SIZE_16K=y
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_ARM_AARCH64=y
BR2_WGET="wget -nd -t 3 --timeout=30 --retry-connrefused"
BR2_TARGET_GENERIC_HOSTNAME="shire-aarch64-pil"
BR2_PACKAGE_ZEROMQ=y
BR2_PACKAGE_LIBGCRYPT=y
BR2_PACKAGE_LIBSOCKETCAN=y
BR2_TARGET_ROOTFS_TAR=y
# BR2_LINUX_KERNEL is not set
# BR2_TARGET_UBOOT is not set
