# Dockerfile for 42 Dynamics Simulator with SHIRE Integration
# Based on 42's official container but with SHIRE spacecraft config and build process

ARG BASE_IMAGE=ghcr.io/haisamido/x-vnc:latest
FROM ${BASE_IMAGE}

# Generate self-signed cert for noVNC
RUN openssl req -x509 -nodes -newkey rsa:2048 -keyout ~/novnc.pem -out ~/novnc.pem \
    -days 3650 -subj "/C=US/ST=NY/L=NY/O=NY/OU=NY/CN=NY emailAddress=email@example.com"

# Install 42 graphics dependencies
RUN apt-get update && \
    apt-get -y install libglu1-mesa-dev freeglut3-dev mesa-common-dev libglfw3-dev && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Copy local 42 source (includes our SHIRE-specific modifications)
COPY 42/ /42/

# Build 42 executable once at image build time with our modifications
RUN cd ./42 && make -j$(nproc)

# Start with 42's baseline InOut configuration
# Then overlay SHIRE's customizations (only files that differ from baseline)
COPY cfg/42_shire_config/ /42/InOut/

# Copy rendered Inp_Sim.txt from build directory (generated by shire-orchestrator.py)
# This allows graphics to be toggled via active.yaml without editing the template
ARG MISSION=drm
COPY build/${MISSION}/42_config/Inp_Sim.txt /42/InOut/Inp_Sim.txt

# Copy startup script (simplified version of 42's original without rebuild)
COPY cfg/startapp-42.sh /startapp.sh
RUN chmod +x /startapp.sh

# Use 42's standard entrypoint (starts VNC and calls startapp.sh)
COPY cfg/entrypoint-42.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

CMD ["/entrypoint.sh"]
