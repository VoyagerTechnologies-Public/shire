# Build 42 against the configured SHIRE base with the full physics model.
ARG BASE_IMAGE=ghcr.io/voyagertechnologies-public/shire-base:0.0.0
FROM ${BASE_IMAGE} AS builder
WORKDIR /42
# Model data is copied only into the runtime stage. Changes to textures or
# ephemeris files must not invalidate the small compiler-input layer.
COPY 42/Makefile /42/Makefile
COPY 42/Source/ /42/Source/
COPY 42/Include/ /42/Include/
COPY 42/Kit/ /42/Kit/
RUN mkdir -p /42/Object /42/Kit/Object && \
    make BUILD_TYPE=release GUIFLAG= SHADERFLAG= -j"$(nproc)"

# Use the shared native runtime dependencies without the development toolchain.
FROM ghcr.io/voyagertechnologies-public/shire-native-runtime:0.0.0
WORKDIR /42
COPY --from=builder /42/42 /42/42
COPY 42/Model/ /42/Model/
COPY 42/InOut/ /42/InOut/
COPY cfg/42_shire_config/ /42/InOut/
ARG MISSION=drm
COPY build/${MISSION}/42_config/Inp_Sim.txt /42/InOut/Inp_Sim.txt
COPY build/${MISSION}/42_config/Orb_SHIRE.txt /42/InOut/Orb_SHIRE.txt
COPY build/${MISSION}/42_config/SC_SHIRE.txt /42/InOut/SC_SHIRE.txt
CMD ["/42/42"]
