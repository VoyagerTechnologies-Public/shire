# Applied to Buildroot's public zynq_zc702_defconfig. Boot Linux directly in
# QEMU; physical Zybo bootloader/device-tree validation is a separate gate.
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN_ARMV7_EABIHF_GLIBC_STABLE=y
BR2_WGET="wget -nd -t 3 --timeout=30 --retry-connrefused"
BR2_TARGET_GENERIC_HOSTNAME="shire-zynq"
BR2_TARGET_GENERIC_GETTY_PORT="ttyPS0"
BR2_SYSTEM_DHCP="eth0"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="@SHIRE_ROOT@/cfg/qemu/linux.fragment"
BR2_PACKAGE_ZEROMQ=y
BR2_PACKAGE_LIBGCRYPT=y
BR2_PACKAGE_LIBSOCKETCAN=y
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_DROPBEAR_DISABLE_REVERSEDNS=y
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_GZIP=y
# BR2_TARGET_ROOTFS_EXT2 is not set
# BR2_TARGET_UBOOT is not set
# BR2_PACKAGE_HOST_DOSFSTOOLS is not set
# BR2_PACKAGE_HOST_GENIMAGE is not set
# BR2_PACKAGE_HOST_MTOOLS is not set
BR2_ROOTFS_POST_BUILD_SCRIPT=""
BR2_ROOTFS_POST_IMAGE_SCRIPT=""
