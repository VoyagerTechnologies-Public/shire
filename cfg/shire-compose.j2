# lab-compose.j2
# Jinja2 template for shire-compose.yaml with spacecraft-specific images
#
# instance/port_offset/image_tag support Monte Carlo Campaigns
# running many trials' stacks concurrently on one host: each is optional
# and defaults away to reproduce a plain `make scenario` run's compose
# file byte-for-byte when unset.
{% set inst = ('-' + instance | string) if instance else '' %}
{% set voff = (port_offset | default(0) | int) %}
{% set tag = image_tag | default(spacecraft) | default('0.0.0') %}
services:
  shire-42:
    image: shire-42-{{ mission | default('default') }}:{{ tag }}
    container_name: shire-42-{{ spacecraft | default('default') }}{{ inst }}
    networks:
      - shire-net-{{ spacecraft | default('default') }}{{ inst }}
    attach: false
    ports:
      - "{{ 5801 + voff }}:80"  # VNC web interface for 42 graphics visualization
    cpus: "2.0"
    mem_limit: 2g
    environment:
      - MESA_NO_SHM=1
      - FORTYTWO_IPC_MODE=${FORTYTWO_IPC_MODE:-binary}
      - FORTYTWO_GRAPHICS_HZ=${FORTYTWO_GRAPHICS_HZ:-1}
    volumes:
      - simulith_ipc_{{ spacecraft | default('default') }}{{ inst }}:/tmp
    shm_size: '2gb'
{%- if instance %}
    labels:
      - "shire.instance={{ instance }}"
{%- endif %}

  shire-gsw:
    image: shire-gsw-{{ mission | default('default') }}:{{ tag }}
    container_name: shire-gsw-{{ mission | default('default') }}{{ inst }}
    networks:
      - shire-net-{{ spacecraft | default('default') }}{{ inst }}
    attach: false
    ports:
      - "{{ 8090 + voff }}:8090"
    volumes:
      - gsw-data_{{ mission | default('default') }}{{ inst }}:/app/yamcs-data
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8090"]
      interval: 30s
      timeout: 5s
      retries: 10
      start_period: 60s
    cpus: "2.0"
    mem_limit: 1g
{%- if instance %}
    labels:
      - "shire.instance={{ instance }}"
{%- endif %}

  shire-server:
    image: shire-server-{{ mission | default('default') }}:{{ tag }}
    container_name: shire-server-{{ mission | default('default') }}{{ inst }}
    networks:
      - shire-net-{{ spacecraft | default('default') }}{{ inst }}
    stdin_open: true
    tty: true
    environment:
      - NUM_CLIENTS=${NUM_CLIENTS:-2}
      - SIMULITH_LOG_MODE=stdout
      - SIMULITH_SPEED=${SIMULITH_SPEED:-1}
      - SIMULITH_DURATION=${SIMULITH_DURATION:-}
      - SIMULITH_WARMUP=${SIMULITH_WARMUP:-0}
      - SIMULITH_WATCHDOG_SECONDS=${SIMULITH_WATCHDOG_SECONDS:-5}
    command: ["/bin/sh", "-c", "/app/simulith_server_standalone $${NUM_CLIENTS}"]
    cpus: "4.0"
    mem_limit: 2g
    volumes:
      - simulith_ipc_{{ spacecraft | default('default') }}{{ inst }}:/tmp
    tmpfs:
      - /dev/shm:noexec,nosuid,size=1g
    privileged: false
{%- if instance %}
    labels:
      - "shire.instance={{ instance }}"
{%- endif %}

  shire-director:
    image: shire-director-{{ mission | default('default') }}:{{ tag }}
    container_name: shire-director-{{ spacecraft | default('default') }}{{ inst }}
    networks:
      - shire-net-{{ spacecraft | default('default') }}{{ inst }}
    stdin_open: true
    tty: true
    depends_on:
      - shire-42
      - shire-cryptolib
      - shire-gsw
      - shire-server
    environment:
      - SIMULITH_LOG_MODE={{ log_mode | default('stdout') }}
      - FORTYTWO_SOCKET_PATH=/tmp/42_ipc.sock
      - FORTYTWO_IPC_MODE=${FORTYTWO_IPC_MODE:-binary}
      - SIMULITH_SCENARIO_ENABLED=${SIMULITH_SCENARIO_ENABLED:-0}
    command: ["/bin/sh", "-c", "if [ \"$${SIMULITH_SCENARIO_ENABLED}\" = 1 ]; then exec /app/simulith_director_standalone --scenario /run/shire-scenario.json; else exec /app/simulith_director_standalone; fi"]
    cpus: "4.0"
    mem_limit: 512m
    volumes:
      - simulith_ipc_{{ spacecraft | default('default') }}{{ inst }}:/tmp
      - ${SIMULITH_SCENARIO_FILE:-/dev/null}:/run/shire-scenario.json:ro
    tmpfs:
      - /dev/shm:noexec,nosuid,size=100m
{%- if instance %}
    labels:
      - "shire.instance={{ instance }}"
{%- endif %}

  shire-cryptolib:
    image: shire-cryptolib-{{ mission | default('default') }}:{{ tag }}
    container_name: shire-cryptolib-{{ spacecraft | default('default') }}{{ inst }}
    networks:
      - shire-net-{{ spacecraft | default('default') }}{{ inst }}
    stdin_open: true
    tty: true
    depends_on:
      - shire-gsw
    cpus: "1.0"
    mem_limit: 512m
    volumes:
      - simulith_ipc_{{ spacecraft | default('default') }}{{ inst }}:/tmp
    tmpfs:
      - /dev/shm:noexec,nosuid,size=100m
{%- if instance %}
    labels:
      - "shire.instance={{ instance }}"
{%- endif %}

  shire-fsw:
    image: shire-fsw-{{ mission | default('default') }}:{{ tag }}
    container_name: shire-fsw-{{ spacecraft | default('default') }}{{ inst }}
    networks:
      - shire-net-{{ spacecraft | default('default') }}{{ inst }}
    stdin_open: true
    tty: true
    depends_on:
      - shire-cryptolib
      - shire-director
      - shire-server
    environment:
      - SIMULITH_LOG_MODE={{ log_mode | default('stdout') }}
      - SHIRE_GROUND_OUTPUT_HZ=${SHIRE_GROUND_OUTPUT_HZ:-20}
    sysctls:
      - fs.mqueue.msg_max=10000
    ulimits:
      rtprio: 99
    cap_add:
      - SYS_NICE
    cpus: "4.0"
    mem_limit: 2g
    volumes:
      - simulith_ipc_{{ spacecraft | default('default') }}{{ inst }}:/tmp
    tmpfs:
      - /dev/shm:noexec,nosuid,size=1g
    privileged: false
{%- if instance %}
    labels:
      - "shire.instance={{ instance }}"
{%- endif %}

networks:
  shire-net-{{ spacecraft | default('default') }}{{ inst }}:
    driver: bridge
{%- if instance %}
    labels:
      shire.instance: "{{ instance }}"
{%- endif %}

volumes:
  simulith_ipc_{{ spacecraft | default('default') }}{{ inst }}:
    driver: local
{%- if instance %}
    labels:
      shire.instance: "{{ instance }}"
{%- endif %}
  gsw-data_{{ mission | default('default') }}{{ inst }}:
    driver: local
{%- if instance %}
    labels:
      shire.instance: "{{ instance }}"
{%- endif %}
