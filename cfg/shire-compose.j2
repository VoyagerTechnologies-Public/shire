# lab-compose.j2
# Jinja2 template for shire-compose.yaml with spacecraft-specific images
services:
  shire-42:
    image: shire-42-{{ mission | default('default') }}:{{ spacecraft | default('latest') }}
    container_name: shire-42-{{ spacecraft | default('default') }}
    networks:
      - shire-net-{{ spacecraft | default('default') }}
    attach: false
    ports:
      - "5801:80"  # VNC web interface for 42 graphics visualization
    cpus: "2.0"
    mem_limit: 1g
    volumes:
      - simulith_ipc_{{ spacecraft | default('default') }}:/tmp
    tmpfs:
      - /dev/shm:noexec,nosuid,size=500m

  shire-gsw:
    image: shire-gsw-{{ mission | default('default') }}:{{ spacecraft | default('latest') }}
    container_name: shire-gsw-{{ mission | default('default') }}
    networks:
      - shire-net-{{ spacecraft | default('default') }}
    attach: false
    ports:
      - "8090:8090"
    volumes:
      - gsw-data_{{ mission | default('default') }}:/app/yamcs-data
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8090"]
      interval: 30s
      timeout: 5s
      retries: 10
      start_period: 60s
    cpus: "2.0"
    mem_limit: 1g

  shire-server:
    image: shire-server-{{ mission | default('default') }}:{{ spacecraft | default('latest') }}
    container_name: shire-server-{{ mission | default('default') }}
    networks:
      - shire-net-{{ spacecraft | default('default') }}
    stdin_open: true
    tty: true
    environment:
      - NUM_CLIENTS=${NUM_CLIENTS:-2}
      - SIMULITH_LOG_MODE=stdout
    command: ["/bin/sh", "-c", "/app/simulith_server_standalone $${NUM_CLIENTS}"]
    cpus: "4.0"
    mem_limit: 2g
    volumes:
      - simulith_ipc_{{ spacecraft | default('default') }}:/tmp
    tmpfs:
      - /dev/shm:noexec,nosuid,size=1g
    privileged: false

  shire-director:
    image: shire-director-{{ mission | default('default') }}:{{ spacecraft | default('latest') }}
    container_name: shire-director-{{ spacecraft | default('default') }}
    networks:
      - shire-net-{{ spacecraft | default('default') }}
    stdin_open: true
    tty: true
    depends_on:
      - shire-42
      - shire-cryptolib
      - shire-gsw
      - shire-server
    environment:
      - SIMULITH_LOG_MODE={{ log_mode | default('stdout') }}
      - FORTYTWO_SOCKET_PATH=/tmp/42_ipc.sock
    cpus: "4.0"
    mem_limit: 512m
    volumes:
      - simulith_ipc_{{ spacecraft | default('default') }}:/tmp
    tmpfs:
      - /dev/shm:noexec,nosuid,size=100m

  shire-cryptolib:
    image: shire-cryptolib-{{ mission | default('default') }}:{{ spacecraft | default('latest') }}
    container_name: shire-cryptolib-{{ spacecraft | default('default') }}
    networks:
      - shire-net-{{ spacecraft | default('default') }}
    stdin_open: true
    tty: true
    depends_on:
      - shire-gsw
    cpus: "1.0"
    mem_limit: 512m
    volumes:
      - simulith_ipc_{{ spacecraft | default('default') }}:/tmp
    tmpfs:
      - /dev/shm:noexec,nosuid,size=100m

  shire-fsw:
    image: shire-fsw-{{ mission | default('default') }}:{{ spacecraft | default('latest') }}
    container_name: shire-fsw-{{ spacecraft | default('default') }}
    networks:
      - shire-net-{{ spacecraft | default('default') }}
    stdin_open: true
    tty: true
    depends_on:
      - shire-cryptolib
      - shire-director
      - shire-server
    environment:
      - SIMULITH_LOG_MODE={{ log_mode | default('stdout') }}
    sysctls:
      - fs.mqueue.msg_max=10000
    ulimits:
      rtprio: 99
    cap_add:
      - SYS_NICE
    cpus: "4.0"
    mem_limit: 2g
    volumes:
      - simulith_ipc_{{ spacecraft | default('default') }}:/tmp
    tmpfs:
      - /dev/shm:noexec,nosuid,size=1g
    privileged: false

networks:
  shire-net-{{ spacecraft | default('default') }}:
    driver: bridge

volumes:
  simulith_ipc_{{ spacecraft | default('default') }}:
    driver: local
  gsw-data_{{ mission | default('default') }}:
    driver: local
