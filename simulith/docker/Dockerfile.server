# The shared native runtime supplies ZeroMQ without 42 models or build tools.
FROM ghcr.io/voyagertechnologies-public/shire-native-runtime:0.0.0
COPY build/libsimulith.so /app/libsimulith.so
COPY build/simulith_server_standalone /app/simulith_server_standalone
WORKDIR /app
CMD ["/app/simulith_server_standalone", "1"]
